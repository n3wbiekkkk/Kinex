{
  "name": "kinex-browser",
  "version": "0.7.19",
  "description": "Kinex Browser — a fast, private macOS Chromium workspace browser",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/n3wbiekkkk/Kinex.git"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && vite build",
    "build:native": "npm --prefix node_modules/adblock-rs run build-release",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && node tests/integration/run-integration.mjs",
    "test:windows": "npm run build && node tests/integration/run-multi-window.mjs",
    "test:extensions": "npm run build && node tests/integration/run-extensions.mjs",
    "test:recovery": "npm run build && node tests/integration/crash-recovery.mjs",
    "test:e2e": "npm run build && node tests/e2e/run-e2e.mjs",
    "test:leak": "npm run build && node tests/perf/run-leak-stress.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:integration && npm run test:windows && npm run test:extensions && npm run test:recovery && npm run test:e2e && npm run test:keyboard && npm run test:experience && npm run test:shields && npm run test:security && npm run test:shields-startup",
    "bench": "npm run build && node tests/perf/run-benchmarks.mjs",
    "bench:memory-saver": "npm run build && node tests/perf/run-memory-saver-bench.mjs",
    "package:mac": "npm run build && electron-builder --mac --arm64 --publish never --config.mac.identity=- --config.mac.notarize=false --config.mac.entitlements=build/entitlements.preview.mac.plist --config.mac.entitlementsInherit=build/entitlements.preview.mac.plist",
    "release:local": "node scripts/release-local.mjs",
    "test:keyboard": "npm run build && node tests/e2e/run-keyboard-only.mjs",
    "test:experience": "npm run build && node tests/integration/run-experience.mjs",
    "test:shields": "npm run build && node tests/integration/run-shields.mjs",
    "lint": "tsc -p tsconfig.node.json --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.web.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test:security": "npm run build && node tests/integration/run-security.mjs",
    "test:pure": "vitest run --exclude 'src/main/shields/**' --exclude 'src/main/features.test.ts'",
    "test:native": "vitest run src/main/shields src/main/features.test.ts",
    "test:shields-startup": "npm run build && node tests/perf/run-shields-initialization.mjs"
  },
  "build": {
    "afterPack": "scripts/afterPack.cjs",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "appId": "com.kinex.browser",
    "productName": "Kinex",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/n3wbiekkkk/Kinex/releases/latest/download"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/filters/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/adblock-rs/js/index.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web URL",
            "CFBundleURLSchemes": [
              "http",
              "https",
              "kinex",
              "nook"
            ]
          }
        ],
        "NSCameraUsageDescription": "Websites can request camera access after you allow it in Kinex.",
        "NSMicrophoneUsageDescription": "Websites can request microphone access after you allow it in Kinex.",
        "NSLocationWhenInUseUsageDescription": "Websites can request your location after you allow it in Kinex."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    }
  },
  "dependencies": {
    "adblock-rs": "^0.13.5",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.511.0",
    "tldts": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "26.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "minimatch": "11.0.9"
  },
  "author": "Kinex contributors"
}
